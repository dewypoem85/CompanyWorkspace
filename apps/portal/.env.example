GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 회사 홈 로그인 유지 시간입니다. 활동 중에는 자동으로 갱신됩니다(최대 7일).
AUTH_SESSION_HOURS=168
MASTER_EMAIL=company@company.com
MASTER_NAME=회사 마스터
MASTER_HIRE_DATE=2024-01-01

LEAVE_BASE_URL=https://leave.example.com
SCHEDULE_BASE_URL=https://schedule.example.com
CS_BASE_URL=https://cs.example.com
STATISTICS_BASE_URL=https://statistics.example.com
SHEET_BASE_URL=https://sheet.example.com

# Portal 직원 변경을 Leave의 읽기 전용 직원 투영에 내구성 있게 반영합니다.
LEAVE_PROVISIONING_ENABLED=true
LEAVE_PROVISIONING_TIMEOUT_SECONDS=10

# openssl rand -base64 48 등으로 생성한 동일한 값을 Portal/Leave/CS/Statistics에 설정합니다.
COMPANY_SSO_SHARED_SECRET=
COMPANY_SSO_ISSUER=company-portal

ALLOWED_HOSTS=company.example.com;localhost;127.0.0.1;[::1]
SECURITY_TRUST_ANY_FORWARDER=true

# Android 앱 푸시. 서비스 계정 JSON과 APK 서명 키는 저장소 밖에서 관리합니다.
PUSH_ENABLED=false
PUSH_POLL_SECONDS=30
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIAL_PATH=/run/secrets/company-workspace-firebase-admin.json
# 푸시용 override를 함께 사용할 때만 설정합니다. 저장소 밖 읽기 전용 파일이어야 합니다.
FIREBASE_CREDENTIAL_HOST_PATH=C:/dev/docker/private/company-workspace-android/firebase-admin.json
