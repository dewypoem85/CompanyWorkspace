@page
@model CompanyPortal.Pages.IndexModel
@if (Model.CurrentUser is null)
{
    <section class="landing-hero">
        <div class="landing-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span>Private workspace</span>
            <h1>업무의 시작을<br /><span>한 곳에서.</span></h1>
            <p>하나의 회사 계정으로 연차관리, CS, 게임 통계, 시트와 인앱결제 상품 관리 도구에 안전하게 연결됩니다. 직원 정보와 서비스 접근 권한도 이곳에서 일관되게 관리합니다.</p>
            <div class="hero-actions">
                <a class="button button-primary button-large" asp-page="/Account/Login">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.91h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.4Z"/><path d="M12 22c2.7 0 4.97-.9 6.62-2.37l-3.24-2.54c-.9.6-2.05.96-3.38.96-2.6 0-4.81-1.76-5.6-4.13H3.05v2.62A10 10 0 0 0 12 22Z"/><path d="M6.4 13.92A6 6 0 0 1 6.08 12c0-.67.12-1.32.32-1.92V7.46H3.05A10 10 0 0 0 2 12c0 1.61.39 3.13 1.05 4.54l3.35-2.62Z"/><path d="M12 5.95c1.47 0 2.79.51 3.83 1.5L18.7 4.57A9.63 9.63 0 0 0 12 2a10 10 0 0 0-8.95 5.46l3.35 2.62c.79-2.37 3-4.13 5.6-4.13Z"/></svg>
                    회사 계정으로 시작하기
                </a>
                <span class="security-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm-3-10 2 2 4-5"/></svg>승인된 회사 계정만 접근할 수 있습니다</span>
            </div>
        </div>
        <div class="workspace-preview" aria-label="사용 가능한 사내 서비스 미리보기">
            <div class="preview-glow"></div>
            <div class="preview-window">
                <div class="preview-topbar"><span></span><span></span><span></span><small>company.example.com</small></div>
                <div class="preview-content">
                    <div class="preview-heading"><span></span><div><strong>Good morning</strong><small>Your workspace is ready.</small></div></div>
                    <div class="preview-grid">
                        <article class="preview-card preview-leave"><span class="preview-icon">L</span><div><strong>연차관리</strong><small>Leave Management</small></div><b>→</b></article>
                        <article class="preview-card preview-cs"><span class="preview-icon">CS</span><div><strong>고객지원</strong><small>Operations Console</small></div><b>→</b></article>
                        <article class="preview-card preview-statistics"><span class="preview-icon">ST</span><div><strong>게임 통계</strong><small>Game Analytics</small></div><b>→</b></article>
                        <article class="preview-card preview-sheet"><span class="preview-icon">SH</span><div><strong>시트 관리</strong><small>Sheet Control</small></div><b>→</b></article>
                    </div>
                    <div class="preview-activity"><i></i><span></span><span></span></div>
                </div>
            </div>
        </div>
    </section>
    <section class="trust-strip" aria-label="포털 특징">
        <div><strong>Single Sign-On</strong><span>한 번의 로그인으로 연결</span></div>
        <div><strong>Role-based Access</strong><span>직원별 안전한 권한 관리</span></div>
        <div><strong>Central Directory</strong><span>일관된 회사 계정 정보</span></div>
    </section>
}
else
{
    <section class="dashboard-hero">
        <div>
            <span class="eyebrow"><span class="eyebrow-dot"></span>Company workspace</span>
            <h1><span>@Model.CurrentUser.Name</span>님, 반갑습니다.</h1>
            <p>오늘 사용할 업무 도구를 선택하세요. 권한 확인 후 별도 로그인 없이 바로 연결됩니다.</p>
        </div>

    </section>
    <section class="workspace-section" id="services">
        <div class="section-heading">
            <div><span class="section-kicker">Workspace</span><h2>업무 도구</h2></div>
            <span class="service-count cw-state-pill" data-tone="success"><i></i>@(Model.AvailableSystems.Count)개 서비스 사용 가능</span>
        </div>
        <div class="system-grid">
            @foreach (var system in Model.AvailableSystems)
            {
                <article class="system-card system-@system.Key">
                    <div class="system-card-top">
                        <span class="system-icon" aria-hidden="true">@(system.Key == "schedule" ? "SC" : system.Key == "cs" ? "CS" : system.Key == "statistics" ? "ST" : system.Key == "sheet" ? "SH" : system.Key == "iap" ? "IAP" : "L")</span>
                        <span class="system-status cw-state-pill" data-tone="success">사용 가능</span>
                    </div>
                    <div class="system-card-copy"><span>@(system.Key == "schedule" ? "TEAM SCHEDULE" : system.Key == "cs" ? "OPERATIONS" : system.Key == "statistics" ? "GAME ANALYTICS" : system.Key == "sheet" ? "DATA OPERATIONS" : system.Key == "iap" ? "PRODUCT MANAGEMENT" : "WORK & LEAVE")</span><h3>@system.Name</h3><p>@system.Description</p></div>
                    <a class="system-link" href="@system.LaunchPath"><span>@system.Name 열기</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
                </article>
            }
            @if (User.IsInRole("Admin"))
            {
                <article class="system-card system-admin">
                    <div class="system-card-top"><span class="system-icon" aria-hidden="true">A</span><span class="system-status admin cw-state-pill" data-tone="warning">관리자</span></div>
                    <div class="system-card-copy"><span>ADMINISTRATION</span><h3>회사 계정·접근 권한</h3><p>직원과 공용 테스트 계정, 상태와 사내 시스템 접근 권한을 관리합니다.</p></div>
                    <a class="system-link" asp-page="/Admin/Users"><span>계정 관리 열기</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
                </article>
            }
            @if (Model.AvailableSystems.Count == 0)
            {
                <article class="system-card muted">
                    <div class="system-card-copy"><span>NO ACCESS</span><h3>사용 가능한 시스템이 없습니다</h3><p>회사 관리자에게 필요한 시스템 접근 권한을 요청하세요.</p></div>
                </article>
            }
        </div>
    </section>
    <section class="workspace-help">
        <div class="help-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm-3-10 2 2 4-5"/></svg></div>
        <div><strong>회사 계정으로 안전하게 연결됩니다</strong><p>서비스를 열 때마다 현재 재직 상태와 접근 권한을 확인합니다. 접근이 필요한 도구가 보이지 않으면 회사 관리자에게 문의하세요.</p></div>
    </section>
}
