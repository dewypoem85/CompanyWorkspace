@page "/Auth/{system}"
@model CompanyPortal.Pages.Auth.LaunchModel
@{
    ViewData["Title"] = $"{Model.SystemName}로 이동";
}
<section class="state-page state-loading">
    <span class="launch-spinner" aria-hidden="true"></span>
    <span class="eyebrow">Secure connection</span>
    <h1>@(Model.SystemName)에 연결하고 있습니다</h1>
    <p>회사 계정과 접근 권한 확인을 마쳤습니다.<br />잠시 후 안전하게 이동합니다.</p>
    <form id="ssoLaunchForm" method="post" action="@Model.CallbackUrl">
        <input type="hidden" name="token" value="@Model.Token" />
        <button class="cw-button" type="submit">직접 이동하기</button>
    </form>
</section>
<script>
    document.getElementById('ssoLaunchForm')?.submit();
</script>
