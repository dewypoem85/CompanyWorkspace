PORT=4173
TEST_SPREADSHEET_ID=10ryam8K5qbNZ7EFjW1YjvOEzGbEf9uh5dR36daNQuog
GOOGLE_SERVICE_ACCOUNT_FILE=../private/sheet-google-service-account.json

# 둘 중 하나를 사용합니다.
# Docker를 사용하지 않는 로컬 실행에서는 아래 경로를 직접 지정할 수 있습니다.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 운영 환경에서만 명시적으로 활성화합니다.
ALLOW_SHEET_WRITES=false

# 회사 Portal SSO. 운영에서는 REQUIRED=true로 두고 Portal과 같은 공유 키를 사용합니다.
COMPANY_SSO_REQUIRED=false
COMPANY_PORTAL_URL=https://company.example.com
COMPANY_SSO_ISSUER=company-portal
COMPANY_SSO_SHARED_SECRET=
SHEET_SESSION_MINUTES=10080
COOKIE_SECURE=true
TRUST_PROXY=true
