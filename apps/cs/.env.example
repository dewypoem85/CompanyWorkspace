# Steamworks Web API Publisher Key (Microtransaction 권한 필요)
# 절대 Git에 커밋하지 마세요.
STEAM_PUBLISHER_KEY=
STEAM_APP_ID=2712460

# 테스트를 마치기 전까지 true 유지
STEAM_USE_SANDBOX=false

# true로 바꿔야 RefundTxn 호출 가능
STEAM_REFUND_ENABLED=false

# PlayFab 상품 지급/회수: 라이브 서버
PLAYFAB_LIVE_TITLE_ID=
PLAYFAB_LIVE_SECRET_KEY=

# PlayFab 상품 지급/회수: 테스트 서버
PLAYFAB_TEST_TITLE_ID=
PLAYFAB_TEST_SECRET_KEY=

PLAYFAB_PRODUCT_COMMANDS_MOCK_MODE=false
PLAYFAB_PRODUCT_COMMANDS_LIVE_ENABLED=false
PLAYFAB_PRODUCT_COMMANDS_TEST_ENABLED=false
PLAYFAB_PRODUCT_COMMANDS_CONCURRENCY=4

# PlayFab 플레이어 UserData 전체 조회/편집 (압축된 SaveData는 GZip + Base64 자동 처리)
# 조회는 Title ID/Secret Key가 있으면 가능하며, 쓰기는 서버별 플래그를 별도로 켜야 합니다.
PLAYFAB_PLAYER_DATA_MOCK_MODE=false
PLAYFAB_PLAYER_DATA_LIVE_ENABLED=false
PLAYFAB_PLAYER_DATA_TEST_ENABLED=false

# Azure Blob Storage에 저장된 PlayFab Parquet 로그 검색
AZURE_PLAYFAB_LOG_STORAGE_ACCOUNT=
AZURE_PLAYFAB_LOG_CONTAINER=logs
AZURE_PLAYFAB_LOG_PREFIX=data
AZURE_PLAYFAB_LOG_SAS_TOKEN=
AZURE_PLAYFAB_LOG_CONCURRENCY=4
# 동시에 실행할 직원별 로그 검색 작업 수 (1~8)
AZURE_PLAYFAB_LOG_JOB_CONCURRENCY=4

# Company Portal 중앙 인증 설정
COMPANY_PORTAL_URL=https://company.example.com
COMPANY_SSO_ISSUER=company-portal
# Company Portal의 CS 시스템 설정과 동일한 32자 이상 값을 사용합니다.
COMPANY_SSO_SHARED_SECRET=
# CS 세션은 최대 8시간 유지되며 사용 중에는 자동 갱신됩니다.
CS_SESSION_MINUTES=10080
CS_INTERNAL_PORT=3100

HOST=0.0.0.0
PORT=3000

# HTTPS 프록시/Cloudflare Tunnel 뒤에서 운영할 때 둘 다 true 권장
COOKIE_SECURE=false
TRUST_PROXY=false
