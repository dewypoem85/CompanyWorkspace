# Docker Compose production settings (copy to .env and supply real secrets).
IAP_DB_PASSWORD=
IAP_ORIGIN=https://iap.example.com
IAP_SECRETS_DIR=../private/iap
COMPANY_SSO_SHARED_SECRET=
COMPANY_PORTAL_URL=https://company.example.com

# Direct local Node process settings; Compose sets these independently.
PORT=4180
DATABASE_URL=postgres://iap:local-development-only@127.0.0.1:5438/iap
APP_ORIGIN=http://localhost:4180
COMPANY_PORTAL_INTERNAL_URL=http://company-portal:8080
COOKIE_SECURE=true
# Only local development, never combined with live connectors.
DEMO_MODE=false
CONNECTOR_CONFIG_FILE=/run/secrets/iap-connectors.json
