# 라이브 PlayFab 로그가 Export되는 Azure Blob Storage
AZURE_PLAYFAB_LOG_STORAGE_ACCOUNT=
AZURE_PLAYFAB_LOG_CONTAINER=logs
AZURE_PLAYFAB_LOG_PREFIX=data
AZURE_PLAYFAB_LOG_SAS_TOKEN=
AZURE_PLAYFAB_LOG_CONCURRENCY=6
AZURE_PLAYFAB_BACKFILL_CONCURRENCY=16

# 통계 전용 Azure Blob Storage. 원본과 같은 계정을 사용해도 되지만 별도 컨테이너와 SAS를 사용합니다.
# 컨테이너를 먼저 생성하고 SAS에는 Read(r), Create(c), Write(w), List(l)만 부여합니다.
# 비워 두면 기존 로컬 Docker volume 캐시 방식으로 동작합니다.
AZURE_STATISTICS_STORAGE_ACCOUNT=
AZURE_STATISTICS_CONTAINER=statistics
AZURE_STATISTICS_PREFIX=playfab-analytics/v2
AZURE_STATISTICS_SAS_TOKEN=

# 라이브 PlayFab Title만 사용합니다.
PLAYFAB_LIVE_TITLE_ID=

# LogManager.cs에서 PlayFab으로 보내는 이벤트 이름. 쉼표로 별칭을 추가할 수 있습니다.
STATISTICS_EVENT_BATTLE_RESULT=battle_result
STATISTICS_EVENT_BOSS_ENCOUNTER=boss_encounter
STATISTICS_EVENT_BOSS_KILL=boss_kill

# 신규 Azure Blob 목록 재확인 주기. 처리된 Blob과 이벤트 캐시는 Docker volume에 영속 저장됩니다.
STATISTICS_CACHE_MINUTES=10
# 화면용 통계는 접속 요청과 분리해 매일 KST 기준 이 시각에 새 완료본을 발행합니다.
STATISTICS_DAILY_REFRESH_HOUR_KST=6
# Azure 원본은 영구 보관하고 ClickHouse의 빠른 조회용 원본·집계만 이 기간 뒤 자동 삭제합니다.
STATISTICS_RETENTION_DAYS=90
# 정기 발행 시 미리 생성할 기간 필터입니다. 버전·모드 등 자주 쓰는 조합도 함께 캐싱합니다.
STATISTICS_PRECACHE_DAYS=7,30,90
# 일일 또는 수동 갱신 때 Azure 원본에서 새 Blob을 확인할 최근 일수입니다. 과거 데이터는 영속 일별 캐시에서 재사용합니다.
STATISTICS_SYNC_LOOKBACK_DAYS=2
STATISTICS_DATA_DIR=/app/data

# 아이콘 호버 상세정보를 Google Sheets에서 갱신할 때 사용하는 읽기 전용 서비스 계정 파일입니다.
# 운영 파일은 저장소 밖에 두고 해당 시트들에 뷰어 권한만 부여합니다.
STATISTICS_GOOGLE_SERVICE_ACCOUNT_FILE=C:/dev/docker/private/sheet-google-service-account.json

# Company Portal 중앙 인증. 키 값은 Portal과 같아야 하지만 파일은 별도로 관리합니다.
COMPANY_PORTAL_URL=https://company.example.com
COMPANY_SSO_ISSUER=company-portal
COMPANY_SSO_SHARED_SECRET=
STATISTICS_SESSION_MINUTES=10080
STATISTICS_INTERNAL_PORT=3110

HOST=0.0.0.0
PORT=3010
NODE_ENV=production

# HTTPS 프록시/Cloudflare Tunnel 뒤에서는 둘 다 true
COOKIE_SECURE=true
TRUST_PROXY=true
