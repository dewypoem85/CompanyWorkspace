PUBLIC_BASE_URL=https://leave.example.com
ALLOWED_HOSTS=leave.example.com;localhost;127.0.0.1;[::1]

# Company Portal이 유일한 로그인·직원·접근권한 원본입니다.
COMPANY_PORTAL_URL=https://company.example.com
COMPANY_SSO_ISSUER=company-portal
# Portal/Leave/CS 세 서비스에 동일한 32자 이상의 값을 설정합니다.
COMPANY_SSO_SHARED_SECRET=

# 연차관리 로그인 유지 시간입니다. 활동 중에는 자동으로 갱신됩니다(최대 24시간).
AUTH_SESSION_HOURS=168

# 보안 설정
SECURITY_FORCE_DELETE_REQUIRES_MASTER=true
SECURITY_REQUIRE_REASONS=true
SECURITY_TRUST_ANY_FORWARDER=true

# DB 자동 백업
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Discord 개인 DM 알림용 OAuth/Bot 설정
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_OAUTH_REDIRECT_URI=https://leave.example.com/Auth/DiscordCallback
