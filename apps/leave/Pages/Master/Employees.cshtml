@page
@model LeaveManager.Pages.Master.EmployeesModel

<h1>회사 계정 연결 현황</h1>
<p>계정 활성 상태와 시스템 권한은 Company Portal에서 관리합니다. 이 화면은 연차 DB에 연결된 로컬 프로필을 확인하는 용도입니다.</p>
@if (Model.PortalUsersUrl != "#")
{
    <p><a class="button" href="@Model.PortalUsersUrl">Company Portal 계정·권한 관리 열기</a></p>
}
<div class="cw-table-scroll" tabindex="0" role="region" aria-label="현황 표"><table class="cw-data-table" data-layout="cards" role="table">
    <thead>
        <tr>
            <th scope="col">회사 계정 ID</th>
            <th scope="col">이름</th>
            <th scope="col">이메일</th>
            <th scope="col">입사일</th>
            <th scope="col">연차 역할</th>
            <th scope="col">로컬 활성</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var employee in Model.Employees)
    {
        <tr>
            <td data-label="회사 계정 ID"><div class="cw-table-value">@(employee.CompanyUserId?.ToString() ?? "미연결")</div></td>
            <td data-label="이름"><div class="cw-table-value"><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@employee.Id">@System.Globalization.StringInfo.GetNextTextElement(employee.Name)</span>@employee.Name</div></td>
            <td data-label="이메일"><div class="cw-table-value">@employee.Email</div></td>
            <td data-label="입사일"><div class="cw-table-value">@employee.HireDate</div></td>
            <td data-label="연차 역할"><div class="cw-table-value">@employee.Role</div></td>
            <td data-label="로컬 활성"><div class="cw-table-value">@employee.IsActive</div></td>
        </tr>
    }
    </tbody>
</table></div>
