@page
@model LeaveManager.Pages.Admin.SettlementsModel
@using LeaveManager.Pages.Admin
<link rel="stylesheet" href="~/css/leave-settlements.css" asp-append-version="true" />
<div data-settlement-screen data-actor="@Model.ActorId" data-today="@Model.Today.ToString("yyyy-MM-dd")" data-locked="@Model.Locked.ToString().ToLowerInvariant()" data-reason-required="@Model.ReasonRequired.ToString().ToLowerInvariant()">
    <div class="page-title-row"><div><p class="eyebrow">연차 정산</p><h1>소멸·이월·보상 처리</h1><p class="muted-text">유효한 발생분의 잔여량을 확인하고 정산합니다. 가불 차감은 자동 처리됩니다.</p></div></div>
    <div data-settlement-state hidden></div>
    @if (Model.Error is not null) {
        <div data-workspace-state="error" data-state-title="정산 내역을 확인해 주세요." data-state-message="@Model.Error"></div>
        <p>제출한 입력 원문입니다. 현재 내역을 확인한 뒤 새 화면에서 작업해 주세요.</p>
        <pre class="settlement-raw-draft">@Model.RawDraft</pre>
    }
    <p data-settlement-recheck hidden="@(!Model.Locked)"><a asp-page="/Admin/Settlements" target="_blank" rel="noopener">새 탭에서 최신 정산 내역 확인</a></p>
    <section class="panel settlement-panel">
        <div class="panel-head"><div><h2>정산 등록</h2><p>소멸·보상은 원본 잔여량을 차감합니다. 이월은 차감한 만큼 오늘부터 1년간 사용할 발생분을 만듭니다.</p></div></div>
        @if (Model.Grants.Count == 0) {
            <div data-workspace-state="empty" data-state-title="정산 가능한 발생분이 없습니다." data-state-message="재직 직원의 유효한 발생분 중 잔여량이 있는 항목만 표시합니다."></div>
        } else {
        <form method="post" asp-antiforgery="true" data-settlement-form>
            <fieldset class="cw-form-fields" disabled="@Model.Locked">
                <label class="cw-form-field" data-settlement-employee hidden>직원 검색
                    <select class="cw-form-control" id="settlementEmployee" data-company-picker="employee" data-company-local="true">
                        @foreach (var employee in Model.Grants.Select(x => x.Grant.Employee).DistinctBy(x => x.Id)) {
                            <option value="@employee.Id">@employee.Name (@employee.Email) @(employee.IsPrivate ? "· 비공개" : "")</option>
                        }
                    </select>
                </label>
                <label class="cw-form-field cw-form-wide">발생분
                    <select class="cw-form-control" name="grantId" required>
                        @foreach (var g in Model.Grants) {
                            <option value="@g.Grant.Id" data-employee="@g.Grant.EmployeeId" data-name="@g.Grant.Employee.Name" data-snapshot="@Model.Snapshots[g.Grant.Id]" data-available="@SettlementsModel.Days(g.Available)">@g.Grant.Employee.Name / @g.Grant.GrantedDate.ToString("yyyy-MM-dd") ~ @g.Grant.ExpiresDate.ToString("yyyy-MM-dd") / @AdjustmentsModel.GrantTypeName(g.Grant.GrantType) / 잔여 @SettlementsModel.Days(g.Available)일</option>
                        }
                    </select>
                </label>
                <label class="cw-form-field">처리 종류<select class="cw-form-control" name="type"><option value="Expiration">소멸</option><option value="CarryOver">이월</option><option value="Compensation">보상</option></select></label>
                <label class="cw-form-field">처리 일수<input class="cw-form-control" name="days" type="number" min="0.5" step="0.5" required /><small>0.5일 단위로 입력하세요.</small></label>
                <label class="cw-form-field cw-form-wide">정산 사유<textarea class="cw-form-control" name="note" rows="3" required="@Model.ReasonRequired"></textarea></label>
                <div class="cw-form-wide settlement-actions"><button type="submit" class="cw-button" data-variant="primary">정산 처리</button><span data-settlement-summary aria-live="polite"></span></div>
            </fieldset>
        </form>
        }
    </section>
    <section class="panel settlement-panel">
        <div class="panel-head"><div><h2>최근 처리 내역</h2><p>최근 100건 · 화면을 연 시점의 내역입니다. 보상은 정산 기록이며 실제 급여 지급을 실행하지 않습니다.</p></div></div>
        @if (Model.History.Count == 0) {
            <div data-workspace-state="empty" data-state-title="정산 내역이 없습니다." data-state-message="처리한 소멸·이월·보상과 자동 가불 차감 내역을 여기서 확인할 수 있습니다."></div>
        } else {
        <div class="cw-table-scroll"><table class="cw-data-table settlement-history"><thead><tr><th scope="col">처리일</th><th scope="col">직원</th><th scope="col">처리</th><th scope="col">일수</th><th scope="col">발생분</th><th scope="col">사유</th><th scope="col">처리자</th></tr></thead><tbody>
            @foreach (var s in Model.History) {
                Model.Employees.TryGetValue(s.EmployeeId, out var employee);
                Model.Employees.TryGetValue(s.ProcessedByEmployeeId, out var actor);
                <tr><td>@s.ProcessedDate.ToString("yyyy-MM-dd")</td><td><span class="cw-entity-avatar" data-company-local-employee="@s.EmployeeId">@(employee?.Name.FirstOrDefault())</span> @(employee?.Name ?? $"직원 #{s.EmployeeId}")</td><td>@SettlementsModel.TypeLabel(s.Type)</td><td>@SettlementsModel.Days(s.Days)일</td><td>#@s.SourceGrantId @if (s.CreatedGrantId is not null) { <span>→ #@s.CreatedGrantId</span> }</td><td>@s.Note</td><td><span class="cw-entity-avatar" data-company-local-employee="@s.ProcessedByEmployeeId">@(actor?.Name.FirstOrDefault())</span> @(actor?.Name ?? $"직원 #{s.ProcessedByEmployeeId}")</td></tr>
            }
        </tbody></table></div>
        }
    </section>
</div>
@section Scripts { <script src="~/js/leave-settlements.js" asp-append-version="true"></script> }
