@page
@model LeaveManager.Pages.Leave.IndexModel
@{
    var week = new[] { "일", "월", "화", "수", "목", "금", "토" };
    var today = LeaveManager.Services.AppTime.Today;
    var prevMonth = new DateOnly(Model.Year, Model.Month, 1).AddMonths(-1);
    var nextMonth = new DateOnly(Model.Year, Model.Month, 1).AddMonths(1);
}
<link rel="stylesheet" href="~/css/year-calendar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/leave-application.css" asp-append-version="true" />

<section class="page-title-row">
    <div>
        <p class="eyebrow">Leave dashboard</p>
        <h1><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@Model.Employee.Id">@System.Globalization.StringInfo.GetNextTextElement(Model.Employee.Name)</span>@Model.Employee.Name 님의 연차</h1>
        @if (Model.IsAdminPreview)
        {
            <p class="admin-preview-banner">관리자 대신보기 모드입니다. 신청·취소 작업은 할 수 없고 화면 확인만 가능합니다.</p>
        }
    </div>
    <div class="title-actions">
        @if (Model.CurrentEmployee.IsAdmin)
        {
            <form method="get" class="view-as-form">
                <input type="hidden" name="Year" value="@Model.Year" />
                <input type="hidden" name="Month" value="@Model.Month" />
                <input type="hidden" name="CalendarView" value="@Model.CalendarView" />
                <input type="hidden" name="RequestLimit" value="@Model.RequestLimit" />
                <input type="hidden" name="SelfOnly" value="@(Model.SelfOnly ? "true" : "false")" />
                <label class="cw-form-field">대신보기
                    <select class="cw-form-control" name="ViewEmployeeId" data-company-picker="employee" data-company-local="true" data-cw-auto-submit>
                        <option value="">내 화면</option>
                        @foreach (var e in Model.ViewableEmployees)
                        {
                            if (Model.ViewEmployeeId == e.Id) { <option value="@e.Id" selected>@e.Name (@e.Email)</option> }
                            else { <option value="@e.Id">@e.Name (@e.Email)</option> }
                        }
                    </select>
                </label>
            </form>
        }
        <a class="btn btn-secondary" asp-page="/Leave/Usage">사용 통계</a>
        @if (!Model.IsAdminPreview)
        {
            <button type="button" class="cw-button" data-variant="primary" id="openApplyPanel">연차 신청</button>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div data-workspace-state="error" data-state-title="처리 내용을 확인해 주세요." data-state-message="@Model.Error"><noscript>@Model.Error</noscript></div>
}
@if (Model.AdminForceRawDraft is not null)
{
    <section class="admin-force-recovery" aria-label="관리자 연차 제출 내용">
        <p>제출한 내용은 아래에 보관했습니다. 이 화면에서 강제 추가·삭제를 반복하지 말고, 새 탭에서 현재 연차 내역을 확인해 주세요.</p>
        <a asp-page="/Leave/Index" target="_blank" rel="noopener">현재 연차 내역 확인</a>
        <pre>@Model.AdminForceRawDraft</pre>
    </section>
}
@if (Model.ExternalScheduleRawDraft is not null)
{
    <section class="external-schedule-recovery" aria-label="외부 일정 제출 내용">
        <p>제출한 내용은 아래에 보관했습니다. 이 화면에서 외부 일정 변경을 반복하지 말고, 새 탭에서 현재 일정을 확인해 주세요.</p>
        <a asp-page="/Leave/Index" target="_blank" rel="noopener">현재 일정 확인</a>
        <pre>@Model.ExternalScheduleRawDraft</pre>
    </section>
}

<div class="metric-grid compact-metrics">
    <article class="metric-card">
        <span>사용</span>
        <strong>@Model.CurrentYearUsedDays</strong>
        <small>일 · 지급 @(Model.CurrentYearGrantedDays)일</small>
        @if (Model.CurrentYearPendingDays > 0)
        {
            <small>승인 대기 @(Model.CurrentYearPendingDays)일</small>
        }
    </article>
    <article class="metric-card accent">
        <span>남은 연차</span>
        <strong>@Model.Balance.Available</strong>
        <small>일</small>
    </article>
    @if (Model.OutstandingAdvanceDays > 0)
    {
        <article class="metric-card warning-metric">
            <span>휴가 가불</span>
            <strong>@Model.OutstandingAdvanceDays</strong>
            <small>일 · 월차 @(Model.OutstandingMonthlyAdvanceDays)일 / 연차 @(Model.OutstandingAnnualAdvanceDays)일 차감 예정</small>
        </article>
    }
    <article class="metric-card wide renewal-metric">
        <span>다음 갱신</span>
        <strong>@Model.NextRenewalLabel</strong>
        <small class="d-day">@Model.NextRenewalDday</small>
    </article>
</div>

@if (!Model.IsAdminPreview && Model.BirthdayLeave.IsAvailable)
{
    <section class="cw-callout birthday-leave-summary" data-tone="info" role="note">
        <strong>@Model.BirthdayLeave.Title</strong>
        <p>@Model.BirthdayLeave.Message</p>
    </section>
    <p class="birthday-leave-summary-action"><button type="button" class="cw-button" data-variant="primary" id="openBirthdayApply">🎂 생일연차 신청하기</button></p>
}

@if (!Model.IsAdminPreview)
{
<section class="panel apply-panel @(Model.ShowApplyPanel ? "" : "is-hidden")" id="applyPanel">
    <div class="panel-head">
        <div>
            <h2>연차 신청</h2>
            <p>신청 버튼을 누른 뒤 월간 달력의 날짜를 선택하세요. 날짜는 직접 입력할 수도 있습니다. 연차·기타는 범위 선택, 반차·생일연차는 하루만 선택됩니다.</p>
        </div>
    </div>
    @if (Model.Balance.Available <= 0)
    {
        <div class="advance-warning" id="noBalanceWarning">
            현재 남은 연차가 없습니다. 부족분은 <b>월차/연차 가불</b>로 신청되며, 0년차는 앞으로 발생할 월차를 먼저 차감하고 초과분은 1년차 연차에서 차감됩니다.
        </div>
    }
    <div class="advance-warning is-hidden" id="advanceWarningBox">
        선택한 신청 일수가 현재 남은 연차보다 큽니다. 부족분은 <b>월차/연차 가불</b>로 기록되고 관리자 화면에도 가불 신청으로 표시됩니다.
    </div>
    <form method="post" asp-antiforgery="true" asp-page-handler="Apply" class="cw-form-fields apply-form" id="applyForm"
          data-birthday-month-day="@(Model.Employee.BirthDate?.ToString("MM-dd") ?? "")"
          data-hire-date="@Model.Employee.HireDate.ToString("yyyy-MM-dd")"
          data-active-birthday-benefits="@string.Join(',', Model.BirthdayLeave.ActiveBenefitDates.Select(x => x.ToString("yyyy-MM-dd")))">
        <input type="hidden" name="expectedEmployeeId" value="@Model.CurrentEmployee.Id" />
        <input type="hidden" name="ViewEmployeeId" value="@Model.ViewEmployeeId" />
        <input type="hidden" name="SelfOnly" value="@Model.SelfOnly.ToString().ToLowerInvariant()" />
        <input type="hidden" name="ShowOthers" value="@Model.ShowOthers.ToString().ToLowerInvariant()" />
        <input type="hidden" name="RequestLimit" value="@Model.RequestLimit" />
        <label class="cw-form-field">시작일
            <input class="cw-form-control" asp-for="Input.StartDate" type="date" id="applyStart" />
        </label>
        <label class="cw-form-field">종료일
            <input class="cw-form-control" asp-for="Input.EndDate" type="date" id="applyEnd" />
        </label>
        <label class="cw-form-field">유형
            <select class="cw-form-control" asp-for="Input.Portion" id="applyPortion">
                <option value="FullDay">연차</option>
                <option value="Morning">오전반차</option>
                <option value="Afternoon">오후반차</option>
                <option value="기타">기타 (연차 미차감)</option>
                <option value="Birthday">🎂 생일연차 (1일·연차 미차감)</option>
            </select>
        </label>
        <section class="cw-callout cw-form-wide birthday-leave-form-status" data-tone="info" role="note" data-birthday-status hidden>
            <strong data-birthday-title>@Model.BirthdayLeave.Title</strong>
            <p data-birthday-message>@Model.BirthdayLeave.Message</p>
        </section>
        <label class="cw-form-field">사유(선택)
            <textarea class="cw-form-control" asp-for="Input.Reason" rows="3" placeholder="필요 시 입력"></textarea>
        </label>
        <label class="cw-form-field cw-form-wide apply-wide">업무 일정 및 인수인계 기록(필수)
            <textarea class="cw-form-control" asp-for="Input.WorkPlan" rows="4" maxlength="2000" required placeholder="예: 오늘 처리 예정 업무, 연차 사용 시 문제 여부, 대신 처리할 직원/인수인계 내용 등을 입력"></textarea>
            <small class="field-help">관리자가 승인 전에 확인할 업무 공백/분담 기록입니다.</small>
        </label>
        <div class="apply-actions">
            <button type="submit" class="cw-button" data-variant="primary" disabled="@Model.ApplicationLocked">신청하기</button>
            <button type="button" class="cw-button" id="cancelApplyPanel">닫기</button>
        </div>
    </form>
    <div data-application-state data-application-locked="@Model.ApplicationLocked.ToString().ToLowerInvariant()" hidden></div>
    <p><a asp-page="/Leave/Index" target="_blank" rel="noopener" data-application-recheck>새 탭에서 현재 신청 내역 확인</a></p>
    @if (Model.ApplicationRawDraft is not null) { <pre class="application-raw-draft">@Model.ApplicationRawDraft</pre> }
</section>
}

<section data-leave-self-screen data-self-locked="@Model.SelfActionLocked.ToString().ToLowerInvariant()">
    <div data-leave-self-state hidden></div>
    <p data-leave-self-recheck hidden><a asp-page="/Leave/Index" target="_blank" rel="noopener">새 탭에서 현재 신청 내역 확인</a></p>
</section>

@if (Model.CanManageExternalSchedules)
{
    <section data-leave-external-screen>
        <div data-leave-external-state hidden></div>
        <p data-leave-external-recheck hidden><a asp-page="/Leave/Index" target="_blank" rel="noopener">새 탭에서 현재 외부 일정 확인</a></p>
    </section>
}
@if (Model.CanAdminEditCalendar)
{
    <section data-leave-admin-screen>
        <div data-leave-admin-state hidden></div>
        <p data-leave-admin-recheck hidden><a asp-page="/Leave/Index" target="_blank" rel="noopener">새 탭에서 현재 관리자 연차 내역 확인</a></p>
        <div data-leave-admin-draft hidden>
            <span>작성 중인 강제 삭제 사유가 있습니다.</span>
            <button type="button" class="cw-button" data-size="compact" data-force-resume>삭제 사유 이어쓰기</button>
            <button type="button" class="cw-button" data-size="compact" data-force-discard>삭제 초안 버리기</button>
        </div>
    </section>
}
<div id="calendarArea" data-calendar-view="@Model.CalendarView" data-read-owner="@Model.CurrentEmployee.Id">
<section class="panel calendar-panel unified-calendar-panel">
    <div class="panel-head calendar-main-head">
        <div class="calendar-title-block">
            <h2>@(Model.IsYearView ? $"{Model.Employee.Name} 님의 {Model.Year}년 연차" : $"{Model.Year}.{Model.Month:00} {(Model.CurrentEmployee.IsAdmin ? "연차·외부 일정 달력" : "연차 달력")}")</h2>
            <p>@(Model.IsYearView ? "12개월 연차와 일정 페이지의 주요일정을 한 화면에서 확인합니다." : Model.CurrentEmployee.IsAdmin ? "연차 신청, 일정 페이지의 주요일정과 관리자 전용 외근·외부 일정을 함께 표시합니다." : "연차 신청·갱신일과 일정 페이지의 주요일정을 함께 표시합니다.")</p>
            <nav class="calendar-view-switch" aria-label="달력 보기 방식">
                <a class="btn calendar-view-button @(Model.IsYearView ? "btn-secondary" : "btn-primary is-active")"
                   data-calendar-view-link="true" asp-page="Index"
                   asp-route-CalendarView="month" asp-route-Year="@today.Year" asp-route-Month="@today.Month"
                   asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit"
                   asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers">월간 보기</a>
                <a class="btn calendar-view-button @(Model.IsYearView ? "btn-primary is-active" : "btn-secondary")"
                   data-calendar-view-link="true" asp-page="Index"
                   asp-route-CalendarView="year" asp-route-Year="@Model.Year" asp-route-Month="@Model.Month"
                   asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit"
                   asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers">연간 보기</a>
            </nav>
        </div>
        <form method="get" class="calendar-toolbar @(Model.IsYearView ? "year-mode-toolbar" : "month-mode-toolbar")" id="calendarMoveForm">
            <input type="hidden" name="CalendarView" value="@Model.CalendarView" />
            <input type="hidden" name="ViewEmployeeId" value="@Model.ViewEmployeeId" />
            <input type="hidden" name="RequestLimit" value="@Model.RequestLimit" />
            <input type="hidden" name="SaveCalendarPreference" value="true" />
            @if (Model.IsYearView)
            {
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="year" asp-route-Year="@(Model.Year - 1)" asp-route-Month="@Model.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">이전 연도</a>
                <input class="cw-form-control" type="number" name="Year" value="@Model.Year" min="2000" max="2100" aria-label="연도" />
                <input type="hidden" name="Month" value="@Model.Month" />
                @if (Model.CurrentEmployee.IsAdmin && !Model.IsAdminPreview)
                {
                    <label class="calendar-self-toggle cw-check-control"><input class="cw-checkbox" type="checkbox" name="SelfOnly" value="true" data-calendar-preference-toggle="true" aria-label="자기것만 보기" @(Model.SelfOnly ? "checked" : "") /> 자기것만 보기<input type="hidden" name="SelfOnly" value="false" /></label>
                }
                else if (!Model.CurrentEmployee.IsAdmin)
                {
                    <label class="calendar-self-toggle calendar-show-others-toggle cw-check-control"><input class="cw-checkbox" type="checkbox" name="ShowOthers" value="true" data-calendar-preference-toggle="true" aria-label="다른 사람 연차도 같이 보기" @(Model.ShowOthers ? "checked" : "") /> 다른 사람 연차도 같이 보기<input type="hidden" name="ShowOthers" value="false" /></label>
                }
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="year" asp-route-Year="@(Model.Year + 1)" asp-route-Month="@Model.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">다음 연도</a>
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="year" asp-route-Year="@today.Year" asp-route-Month="@today.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">올해</a>
            }
            else
            {
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="month" asp-route-Year="@prevMonth.Year" asp-route-Month="@prevMonth.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">이전 달</a>
                <input class="cw-form-control" type="number" name="Year" value="@Model.Year" min="2000" max="2100" aria-label="연도" />
                <select class="cw-form-control" name="Month" aria-label="월">
                    @for (var m = 1; m <= 12; m++)
                    {
                        if (m == Model.Month) { <option value="@m" selected>@m 월</option> }
                        else { <option value="@m">@m 월</option> }
                    }
                </select>
                @if (Model.CurrentEmployee.IsAdmin && !Model.IsAdminPreview)
                {
                    <label class="calendar-self-toggle cw-check-control"><input class="cw-checkbox" type="checkbox" name="SelfOnly" value="true" data-calendar-preference-toggle="true" aria-label="자기것만 보기" @(Model.SelfOnly ? "checked" : "") /> 자기것만 보기<input type="hidden" name="SelfOnly" value="false" /></label>
                }
                else if (!Model.CurrentEmployee.IsAdmin)
                {
                    <label class="calendar-self-toggle calendar-show-others-toggle cw-check-control"><input class="cw-checkbox" type="checkbox" name="ShowOthers" value="true" data-calendar-preference-toggle="true" aria-label="다른 사람 연차도 같이 보기" @(Model.ShowOthers ? "checked" : "") /> 다른 사람 연차도 같이 보기<input type="hidden" name="ShowOthers" value="false" /></label>
                }
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="month" asp-route-Year="@nextMonth.Year" asp-route-Month="@nextMonth.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">다음 달</a>
                <a class="btn btn-secondary" asp-page="Index" asp-route-CalendarView="month" asp-route-Year="@today.Year" asp-route-Month="@today.Month" asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">오늘</a>
            }
        </form>
    </div>

    @if (!Model.ScheduleMilestonesAvailable)
    {
        <div class="calendar-source-status"><span class="cw-state-pill" data-tone="warning">일정 페이지의 주요일정을 불러오지 못했습니다.</span></div>
    }

    @if (Model.IsYearView)
    {
        <div class="year-calendar-content">
            <div class="year-summary-grid">
                <article class="metric-card accent">
                    <span>@Model.Year 년 사용</span>
                    <strong>@Model.FormatDays(Model.CalendarYearUsedDays)</strong>
                    <small>일</small>
                </article>
                <article class="metric-card">
                    <span>@Model.Year 년 승인 대기</span>
                    <strong>@Model.FormatDays(Model.CalendarYearPendingDays)</strong>
                    <small>일</small>
                </article>
                <article class="metric-card year-scope-card">
                    <span>달력 표시 범위</span>
                    <strong>@(Model.IsAdminPreview || Model.SelfOnly ? "선택 직원" : (Model.ShowOthers || Model.CurrentEmployee.IsAdmin ? "여러 직원" : "본인"))</strong>
                    <small>월간 달력의 표시 설정을 그대로 사용합니다.</small>
                </article>
            </div>

            <section class="year-legend" aria-label="달력 범례">
                <span><i class="year-legend-mark approved"></i> 승인</span>
                <span><i class="year-legend-mark pending"></i> 승인 대기</span>
                <span><i class="year-legend-mark cancel"></i> 취소 승인 대기</span>
                <span><i class="year-legend-mark holiday"></i> 공휴일</span>
                <span><i class="year-legend-mark birthday"></i> 생일</span>
                <span><i class="year-legend-mark milestone"></i> 주요일정</span>
                @if (Model.CurrentEmployee.IsAdmin)
                {
                    <span><i class="year-legend-mark external"></i> 외부 일정</span>
                }
            </section>

            <div class="year-calendar-grid">
            @foreach (var month in Model.YearCalendarMonths)
            {
                <section class="year-month-card @(Model.Year == today.Year && month.Month == today.Month ? "is-current-month" : "")">
                    <header class="year-month-head">
                        <a data-calendar-view-link="true" asp-page="Index" asp-route-CalendarView="month" asp-route-Year="@Model.Year" asp-route-Month="@month.Month"
                           asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit">@month.Month 월</a>
                        <div class="year-month-usage">
                            <strong>사용 @Model.FormatDays(month.UsedDays)일</strong>
                            @if (month.PendingDays > 0)
                            {
                                <span>대기 @Model.FormatDays(month.PendingDays)일</span>
                            }
                        </div>
                    </header>
                    <table class="cw-calendar-table year-mini-calendar" data-calendar-layout="year-mini" role="table" aria-label="@($"{Model.Year}년 {month.Month}월 연차 달력")">
                        <thead>
                            <tr>
                            @foreach (var dayName in week)
                            {
                                <th scope="col" class="@(dayName == "일" ? "sun" : dayName == "토" ? "sat" : "")">@dayName</th>
                            }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var calendarWeek in month.Weeks)
                        {
                            <tr>
                            @foreach (var day in calendarWeek)
                            {
                                if (day is null)
                                {
                                    <td class="is-empty"></td>
                                }
                                else
                                {
                                    var dayClasses = string.Join(" ", new[]
                                    {
                                        day.IsToday ? "is-today" : "",
                                        day.Date.DayOfWeek == DayOfWeek.Sunday ? "is-sunday" : "",
                                        day.Date.DayOfWeek == DayOfWeek.Saturday ? "is-saturday" : "",
                                        day.HolidayNames.Count > 0 ? "is-holiday" : ""
                                    }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                    var holidayTitle = day.HolidayNames.Count > 0 ? string.Join(", ", day.HolidayNames) : null;
                                    <td class="@dayClasses">
                                        <a class="year-day-link" data-calendar-view-link="true" asp-page="Index" asp-route-CalendarView="month" asp-route-Year="@Model.Year" asp-route-Month="@month.Month"
                                           asp-route-SelfOnly="@Model.SelfOnly" asp-route-ShowOthers="@Model.ShowOthers" asp-route-ViewEmployeeId="@Model.ViewEmployeeId" asp-route-RequestLimit="@Model.RequestLimit" title="@holidayTitle">
                                            <span class="year-day-number">@day.Date.Day</span>
                                            @if (day.HolidayNames.Count > 0)
                                            {
                                                <span class="year-holiday-name">@day.HolidayNames[0]</span>
                                            }
                                            <span class="year-day-events">
                                            @{ var milestonePreview = day.ScheduleMilestones.Take(1).ToList(); var externalPreview = day.ExternalSchedules.Take(Math.Min(1, Math.Max(0, 3 - milestonePreview.Count))).ToList(); var birthdayPreview = day.Birthdays.Take(Math.Min(1, Math.Max(0, 3 - milestonePreview.Count - externalPreview.Count))).ToList(); var leavePreviewCount = Math.Max(0, 3 - milestonePreview.Count - externalPreview.Count - birthdayPreview.Count); }
                                            @foreach (var milestone in milestonePreview)
                                            {
                                                <span class="year-event milestone" title="@milestone.Title · @milestone.TypeLabel@(string.IsNullOrWhiteSpace(milestone.ProjectName) ? "" : $" · {milestone.ProjectName}")"><span class="milestone-icon" aria-hidden="true">📌</span>@if (!string.IsNullOrWhiteSpace(milestone.ProjectId) && !string.IsNullOrWhiteSpace(milestone.ProjectName)) { <span class="cw-entity-avatar milestone-project-icon" aria-hidden="true" data-company-project="@milestone.ProjectId">@System.Globalization.StringInfo.GetNextTextElement(milestone.ProjectName)</span> }<span class="year-event-title">@milestone.Title</span></span>
                                            }
                                            @foreach (var schedule in externalPreview)
                                            {
                                                <span class="year-event external" title="@schedule.EmployeeName · @schedule.Category · @schedule.Memo"><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@schedule.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(schedule.EmployeeName)</span>@schedule.EmployeeName</span>
                                            }
                                            @foreach (var birthday in birthdayPreview)
                                            {
                                                <span class="year-event birthday @(birthday.IsSelf ? "self" : "other")" data-detail="생일" data-employee-id="@birthday.EmployeeId" title="@birthday.Label"><span class="birthday-icon" aria-hidden="true">🎂</span><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@birthday.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(birthday.EmployeeName)</span>@birthday.EmployeeName 생일</span>
                                            }
                                            @foreach (var item in day.Items.Take(leavePreviewCount))
                                            {
                                                <span class="year-event @Model.StatusClass(item.Status) @(item.IsSelf ? "self" : "other")"
                                                      title="@item.EmployeeName · @Model.PortionName(item.Portion) · @Model.StatusName(item.Status)"><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@item.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(item.EmployeeName)</span>@item.EmployeeName</span>
                                            }
                                            @if (day.Items.Count + day.ExternalSchedules.Count + day.Birthdays.Count + day.ScheduleMilestones.Count > 3)
                                            {
                                                <span class="year-event-more">+@(day.Items.Count + day.ExternalSchedules.Count + day.Birthdays.Count + day.ScheduleMilestones.Count - 3)</span>
                                            }
                                            </span>
                                        </a>
                                    </td>
                                }
                            }
                            </tr>
                        }
                        </tbody>
                    </table>
                </section>
            }
            </div>
        </div>
    }
    else
    {
        <div class="calendar-shell">
            <table class="cw-calendar-table month-calendar selectable-calendar" data-calendar-layout="month" role="table" aria-label="@($"{Model.Year}년 {Model.Month}월 연차 달력")" id="leaveCalendar">
                <thead>
                    <tr>
                        @foreach (var w in week)
                        {
                            <th scope="col" class="@(w == "일" ? "sun" : w == "토" ? "sat" : "")">@w</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.CalendarWeeks)
                    {
                        <tr>
                            @foreach (var day in row.Days)
                            {
                                var classes = string.Join(" ", new[] {
                                    day.IsCurrentMonth ? "" : "is-outside",
                                    day.IsToday ? "is-today" : "",
                                    day.Date.DayOfWeek == DayOfWeek.Sunday ? "is-sunday" : "",
                                    day.Date.DayOfWeek == DayOfWeek.Saturday ? "is-saturday" : "",
                                    day.IsHoliday ? "is-holiday" : "",
                                    "selectable-day"
                                }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                <td class="@classes" data-date="@day.Date.ToString("yyyy-MM-dd")" data-date-label="@day.Date.ToString("yyyy.MM.dd")">
                                    <div class="day-head">
                                        <button type="button" class="cw-button" data-variant="quiet" data-size="compact" data-layout="icon" data-day-detail-trigger aria-label="@day.Date.ToString("yyyy.MM.dd") 날짜 선택"><span class="day-number @(day.IsHoliday ? "holiday-number" : "")">@day.Date.Day</span></button>
                                        @if (day.IsToday) { <span class="today-chip">오늘</span> }
                                    </div>
                                    <div class="day-events">
                                        @foreach (var holiday in day.Holidays)
                                        {
                                            <div class="event-chip holiday" data-detail="공휴일" data-detail-label="@holiday.Name">@holiday.Name</div>
                                        }
                                        @foreach (var milestone in day.ScheduleMilestones)
                                        {
                                            <div class="event-chip milestone" data-detail="주요일정" data-milestone-id="@milestone.MilestoneId" data-occurrence-index="@milestone.OccurrenceIndex" data-milestone-title="@milestone.Title" data-milestone-type="@milestone.TypeLabel" data-project-id="@milestone.ProjectId" data-project-name="@milestone.ProjectName">
                                                <strong><span class="milestone-icon" aria-hidden="true">📌</span>@if (!string.IsNullOrWhiteSpace(milestone.ProjectId) && !string.IsNullOrWhiteSpace(milestone.ProjectName)) { <span class="cw-entity-avatar milestone-project-icon" aria-hidden="true" data-company-project="@milestone.ProjectId">@System.Globalization.StringInfo.GetNextTextElement(milestone.ProjectName)</span> }@milestone.Title</strong>
                                                <span>@milestone.TypeLabel@(string.IsNullOrWhiteSpace(milestone.ProjectName) ? "" : $" · {milestone.ProjectName}")</span>
                                            </div>
                                        }
                                        @foreach (var renewal in day.Renewals)
                                        {
                                            <div class="event-chip renewal @(renewal.IsSelf ? "self-renewal" : "other-renewal") @(renewal.Kind == "월차" ? "monthly-renewal" : "annual-renewal")" data-detail="갱신" data-detail-label="@renewal.Label" data-employee-id="@renewal.EmployeeId" data-employee-name="@renewal.EmployeeName">
                                                <strong><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@renewal.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(renewal.EmployeeName)</span>@renewal.EmployeeName</strong>
                                                <span>@renewal.Kind 갱신</span>
                                            </div>
                                        }
                                        @foreach (var birthday in day.Birthdays)
                                        {
                                            <div class="event-chip birthday @(birthday.IsSelf ? "self-birthday" : "other-birthday")" data-detail="생일" data-detail-label="@birthday.Label" data-employee-id="@birthday.EmployeeId" data-employee-name="@birthday.EmployeeName">
                                                <strong><span class="birthday-icon" aria-hidden="true">🎂</span><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@birthday.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(birthday.EmployeeName)</span>@birthday.EmployeeName</strong>
                                                <span>생일</span>
                                            </div>
                                        }
                                        @foreach (var schedule in day.ExternalSchedules)
                                        {
                                            <div class="event-chip external-schedule" data-detail="외부일정" data-schedule-id="@schedule.Id" data-snapshot="@schedule.Snapshot" data-employee-id="@schedule.EmployeeId" data-employee-name="@schedule.EmployeeName" data-category="@schedule.Category" data-start-date="@schedule.StartDate.ToString("yyyy-MM-dd")" data-end-date="@schedule.EndDate.ToString("yyyy-MM-dd")" data-memo="@schedule.Memo">
                                                <strong><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@schedule.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(schedule.EmployeeName)</span>@schedule.EmployeeName</strong>
                                                <span>@schedule.Category · @schedule.Memo</span>
                                            </div>
                                        }
                                        @foreach (var item in day.Items)
                                        {
                                            <div class="event-chip leave @Model.StatusClass(item.Status) @(item.IsAdvance ? "advance" : "")" data-detail="신청" data-request-id="@item.RequestId" data-employee-id="@item.EmployeeId" data-employee-name="@item.EmployeeName" data-portion-name="@Model.PortionName(item.Portion)" data-status-name="@Model.StatusName(item.Status)" data-status-code="@item.Status" data-can-self-cancel="@item.CanSelfCancel.ToString().ToLowerInvariant()" data-is-advance="@item.IsAdvance.ToString().ToLowerInvariant()" data-advance-days="@item.AdvanceDays" data-reason="@item.Reason" data-work-plan="@item.WorkPlan" data-advance-label="@item.AdvanceLabel" data-request-snapshot="@item.Snapshot" data-request-dates="@item.DateLabel" data-admin-target="@(Model.CanAdminEditCalendar ? item.AdminTarget : null)">
                                                <strong><span class="cw-entity-avatar" aria-hidden="true" data-company-local-employee="@item.EmployeeId">@System.Globalization.StringInfo.GetNextTextElement(item.EmployeeName)</span>@item.EmployeeName</strong>
                                                <span>@Model.PortionName(item.Portion) · @Model.StatusName(item.Status)@(item.IsAdvance ? $" · {item.AdvanceLabel}" : "")</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (!Model.IsYearView)
{
